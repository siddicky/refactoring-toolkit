# Secrets — never commit
.env
.env.*
!.env.example

# Run artifacts (AC2 metrics renders are run outputs, not source).
# Anchored to the repo root so the src/metrics/ TOOLKIT SOURCE stays tracked.
/metrics/

# Toolkit-owned worktree leases (git worktrees created at runtime)
.worktrees/
.worktree/

# Dependencies
node_modules/

# Build output
dist/
*.tsbuildinfo

# dex local dev state (blob caches, one sibling per process: .dex-cache, .dex-cache-client, .dex-cache-watch, .dex-cache-dashboard)
.dex/
.dex-cache*/

# Chaos-kill evidence sidecars written at run time
kill-events*.json
kill-events*.jsonl
# ...but recorded sidecars used as test fixtures are source and stay tracked
!src/metrics/fixtures/kill-events-*.json
!src/metrics/fixtures/kill-events-*.jsonl

# Logs and OS noise
*.log
.DS_Store

# Local agent tool state (OMC, ZCode, Playwright MCP, Claude Code worktrees).
# Only project-scoped OMC skills are meant to be committed.
.omc/*
!.omc/skills/
.playwright-mcp/
.claude/worktrees/
.zcodeignore
