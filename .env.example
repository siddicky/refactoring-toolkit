# Copy to .env (gitignored) and fill in real values. Never commit .env.

# --- dex (durable execution engine) ---
# gRPC address of the dex server started by `dexcli dev` (brew install superdurable/tap/dexcli)
DEX_SERVER_ADDRESS=127.0.0.1:8801
# Worker endpoint advertised by startFlow (must match the worker's bind address)
DEX_WORKER_TARGET=127.0.0.1:8803

# --- opencode (agent harness server) ---
# Base URL of `opencode serve`
OPENCODE_BASE_URL=http://127.0.0.1:4096
# Model used for agent sessions (provider id per opencode config)
OPENCODE_MODEL_PROVIDER=
OPENCODE_MODEL_ID=

# --- TypeSafe (Jev) — used from Phase 3 onward (src/typesafe/, worker-3 scope) ---
TYPESAFE_API_KEY=
