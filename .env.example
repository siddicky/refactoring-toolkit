# Copy to .env (gitignored) and fill in real values. Never commit .env.

# --- dex (durable execution engine) ---
# gRPC address of the dex server started by `dexcli dev` (brew install superdurable/tap/dexcli)
DEX_SERVER_ADDRESS=127.0.0.1:8801
# Worker endpoint advertised by startFlow (must match the worker's bind address)
DEX_WORKER_TARGET=127.0.0.1:8803

# --- opencode (agent harness server) ---
# Base URL of `opencode serve`
OPENCODE_BASE_URL=http://127.0.0.1:4096
# Default model for generic round trips and probe sessions (not port-flow turns)
OPENCODE_MODEL_PROVIDER=
OPENCODE_MODEL_ID=

# Port-flow turns route per lane. Values use providerID/modelID; see
# src/harness/lanes.ts for current defaults and review retry routing.
# Defaults: planner zai-coding-plan/glm-5.3 @ high;
# executor zai-coding-plan/glm-5.3-flash @ max;
# reviewer nano-gpt/openai/gpt-6-luna @ high.
# Configure credentials for every effective lane in OpenCode, or override all
# three model variables to providers/models available in your environment.
OPENCODE_PLANNER_MODEL=
OPENCODE_PLANNER_VARIANT=
OPENCODE_EXECUTOR_MODEL=
OPENCODE_EXECUTOR_VARIANT=
OPENCODE_REVIEWER_MODEL=
OPENCODE_REVIEWER_VARIANT=
# Optional review retry override; otherwise attempt 2+ uses the executor lane.
OPENCODE_REVIEWER_MODEL_FALLBACK=
OPENCODE_REVIEWER_MODEL_FALLBACK_VARIANT=

# --- TypeSafe (Jev) — used from Phase 3 onward (src/typesafe/, worker-3 scope) ---
TYPESAFE_API_KEY=
